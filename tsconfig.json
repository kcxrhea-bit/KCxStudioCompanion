{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",

    "strict": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "types": ["vite/client", "node"]
  },

  "include": ["src/renderer"],
  "exclude": [
    "dist",
    "node_modules",
    "build",
    "**/*.js",
    "**/dist/**"
  ]
}